{
	// 类型环境借用仓内宿主 .sveltecms/：extends 其 SvelteKit 生成层（$app/*
	// 模块声明、$lib paths、路由类型）。paths 子级整体覆盖父级，$lib 需
	// 重新声明指向 .sveltecms/src/lib；宿主 src/app.d.ts（Locals 增强）必须
	// 显式 include。共享库锁本仓 node_modules 防双实例 brand 冲突。
	// 前提：宿主跑过 svelte-kit sync（pnpm check 的 ensure 步骤自动保证）。
	"extends": "./.sveltecms/.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler",
		"noEmit": true,
		"paths": {
			"$lib": ["./.sveltecms/src/lib"],
			"$lib/*": ["./.sveltecms/src/lib/*"],
			"$app/types": ["./.sveltecms/.svelte-kit/types/index.d.ts"],
			"drizzle-orm": ["./node_modules/drizzle-orm"],
			"drizzle-orm/*": ["./node_modules/drizzle-orm/*"],
			"svelte": ["./node_modules/svelte"],
			"svelte/*": ["./node_modules/svelte/*"]
		}
	},
	"include": [
		// 宿主 SvelteKit 生成的类型层 + 全局类型增强（Locals.user 等）
		".sveltecms/.svelte-kit/ambient.d.ts",
		".sveltecms/.svelte-kit/non-ambient.d.ts",
		".sveltecms/.svelte-kit/types/**/$types.d.ts",
		".sveltecms/src/app.d.ts",
		"plugin/**/*.ts",
		"plugin/**/*.svelte"
	],
	"exclude": [".sveltecms/node_modules", ".sveltecms/data", ".sveltecms/build"]
}
